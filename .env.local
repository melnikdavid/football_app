# Copy this to .env for local development:
#   cp .env.local .env

# App
APP_ENV=development
SECRET_KEY=local-dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_USER=moadon
DB_PASSWORD=moadon_dev
DB_NAME=moadon
DATABASE_URL=postgresql+asyncpg://moadon:moadon_dev@db:5432/moadon
DATABASE_SYNC_URL=postgresql://moadon:moadon_dev@db:5432/moadon

# Redis
REDIS_URL=redis://redis:6379/0

# Claude AI — required for /ai endpoints
ANTHROPIC_API_KEY=sk-ant-...

# Leave these blank to skip optional integrations locally:
VIMEO_ACCESS_TOKEN=
VIMEO_ALLOWED_DOMAIN=localhost

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRANZILA_TERMINAL=
PAYME_SELLER_ID=

FCM_SERVER_KEY=
SENDGRID_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

R2_ACCOUNT_ID=
